# Resend transactional email (never commit the real key)
RESEND_API_KEY=re_your_key
CONTACT_FROM=MOMENTUNDIGITAL <web@send.momentundigital.com>
CONTACT_EMAIL=contacto@momentundigital.com
NEXT_PUBLIC_SITE_URL=https://momentundigital.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# CRM gratuito opcional (Google Apps Script Web App)
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/ID/exec

# Token opcional para saltarse el rate limit del formulario de contacto en pruebas
# (enviar como header x-test-bypass con este mismo valor). No configurar en producción normal.
# CONTACT_TEST_BYPASS_TOKEN=un-valor-secreto-solo-para-pruebas
